diff --git a/app/wbw-download-dialog.tsx b/app/wbw-download-dialog.tsx
new file mode 100644
index 0000000..71e5744
--- /dev/null
+++ b/app/wbw-download-dialog.tsx
@@ -0,0 +1,56 @@
+"use client";
+
+import { useEffect, useRef, useState, type KeyboardEvent } from "react";
+
+export type PreparedWbwDownload = { blob: Blob; fileName: string };
+
+export default function WbwDownloadDialog({ download, onClose, onDownload }: {
+  download: PreparedWbwDownload;
+  onClose: () => void;
+  onDownload: () => void;
+}) {
+  const [url, setUrl] = useState("");
+  const panelRef = useRef<HTMLElement>(null);
+  const linkRef = useRef<HTMLAnchorElement>(null);
+
+  useEffect(() => {
+    const previousFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
+    const objectUrl = URL.createObjectURL(download.blob);
+    setUrl(objectUrl);
+    return () => {
+      // Closing just after a click must not invalidate a download still starting.
+      window.setTimeout(() => URL.revokeObjectURL(objectUrl), 60_000);
+      if (previousFocus?.isConnected) previousFocus.focus();
+    };
+  }, [download.blob]);
+
+  useEffect(() => {
+    if (url) linkRef.current?.focus();
+  }, [url]);
+
+  const handleKeyDown = (event: KeyboardEvent<HTMLElement>) => {
+    if (event.key === "Escape") { event.preventDefault(); onClose(); return; }
+    if (event.key !== "Tab") return;
+    const controls = panelRef.current?.querySelectorAll<HTMLElement>("button, a[href]");
+    if (!controls?.length) return;
+    const first = controls[0];
+    const last = controls[controls.length - 1];
+    if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
+    else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
+  };
+
+  return (
+    <div className="editor-backdrop" role="presentation" onMouseDown={(event) => { if (event.target === event.currentTarget) onClose(); }}>
+      <section ref={panelRef} className="editor-modal compact wbw-download-dialog" role="dialog" aria-modal="true" aria-labelledby="wbw-download-title" aria-describedby="wbw-download-instructions" onKeyDown={handleKeyDown}>
+        <div className="editor-head"><div><span>COPIA EDITABLE</span><h2 id="wbw-download-title">Descargar proyecto</h2></div><button type="button" onClick={onClose} aria-label="Cerrar descarga">×</button></div>
+        <div className="wbw-download-details">
+          <p id="wbw-download-instructions">El archivo está preparado. Pulsa Descargar .wbw para guardarlo en tu equipo.</p>
+          <strong>{download.fileName}</strong>
+          <span>{new Intl.NumberFormat("es-CL", { maximumFractionDigits: 2 }).format(download.blob.size / 1024 / 1024)} MB · Manuscrito, fichas y recursos del proyecto</span>
+          <p>El enlace permanece disponible mientras esta ventana esté abierta. Si la descarga no aparece, puedes volver a pulsarlo o usar «Guardar enlace como…» sobre el botón.</p>
+        </div>
+        <footer className="editor-actions"><button type="button" onClick={onClose}>Cerrar</button>{url ? <a ref={linkRef} className="primary-action wbw-download-link" href={url} download={download.fileName} onClick={onDownload}>Descargar .wbw</a> : <span role="status">Preparando enlace…</span>}</footer>
+      </section>
+    </div>
+  );
+}
