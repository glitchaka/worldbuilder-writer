diff --git a/tests/wbw-export.test.mjs b/tests/wbw-export.test.mjs
new file mode 100644
index 0000000..0b94d3f
--- /dev/null
+++ b/tests/wbw-export.test.mjs
@@ -0,0 +1,85 @@
+import assert from "node:assert/strict";
+import { mkdtemp, mkdir, readFile, rm, writeFile } from "node:fs/promises";
+import path from "node:path";
+import { pathToFileURL, fileURLToPath } from "node:url";
+import test, { after } from "node:test";
+import ts from "typescript";
+import JSZip from "jszip";
+
+// Run the production TypeScript modules in Node without changing their browser imports.
+const projectRoot = fileURLToPath(new URL("..", import.meta.url));
+await mkdir(path.join(projectRoot, ".sites-runtime"), { recursive: true });
+const compiled = await mkdtemp(path.join(projectRoot, ".sites-runtime", "wbw-export-"));
+after(() => rm(compiled, { recursive: true, force: true }));
+for (const [sourcePath, name] of [["lib/archive-data.ts", "archive-data"], ["app/wbw-project.ts", "wbw-project"]]) {
+  const source = (await readFile(path.join(projectRoot, sourcePath), "utf8")).replace('"../lib/archive-data"', '"./archive-data.mjs"');
+  const { outputText } = ts.transpileModule(source, { compilerOptions: { target: ts.ScriptTarget.ES2022, module: ts.ModuleKind.ESNext } });
+  await writeFile(path.join(compiled, `${name}.mjs`), outputText);
+}
+const { createBlankArchive } = await import(pathToFileURL(path.join(compiled, "archive-data.mjs")).href);
+const { createWbwPackage, readWbwPackage, WBW_MIME } = await import(pathToFileURL(path.join(compiled, "wbw-project.mjs")).href);
+
+function existingProject() {
+  const state = createBlankArchive({ archiveTitle: "Proyecto existente", storyTitle: "Obra con doce capítulos" });
+  state.writingChapters = Array.from({ length: 12 }, (_, i) => ({
+    id: `chapter-${i}`, label: `Capítulo ${i + 1}`, title: `Título ${i + 1}`, order: i,
+    scenes: [{ id: `scene-${i}`, title: `Escena ${i + 1}`, status: "Borrador", order: 0, content: `<p>Texto del capítulo ${i + 1}.</p><p><strong>Cambios conservados.</strong></p>` }],
+  }));
+  state.manuscript = { ...state.manuscript, chapters: 12, words: 35352 };
+  state.profile.synopsis = "Sinopsis modificada antes de exportar.";
+  return state;
+}
+
+test("exported copy reopens all twelve chapters, manuscript formatting and project data", async () => {
+  const state = existingProject();
+  const before = structuredClone(state);
+  const blob = await createWbwPackage(state, "project-existing");
+  assert.equal(blob.type, WBW_MIME);
+  assert.ok(blob.size > 0);
+  const zip = await JSZip.loadAsync(await blob.arrayBuffer(), { checkCRC32: true });
+  const manifest = JSON.parse(await zip.file("manifest.json").async("string"));
+  assert.equal(manifest.format, "worldbuilder-writer-project");
+  assert.equal(manifest.projectFile, "project.json");
+  const imported = await readWbwPackage(new File([blob], "Proyecto-existente.wbw", { type: WBW_MIME }));
+  assert.deepEqual(imported.state.writingChapters, before.writingChapters);
+  assert.equal(imported.state.manuscript.words, 35352);
+  assert.equal(imported.state.profile.synopsis, before.profile.synopsis);
+  assert.deepEqual(imported.state.maps, before.maps);
+  assert.deepEqual(imported.state.relationships, before.relationships);
+  assert.deepEqual(state, before, "export never mutates the open project");
+});
+
+test("portable copy includes character photos and attachments from World and Magic", async () => {
+  const state = existingProject();
+  const photo = Buffer.from([137, 80, 78, 71, 13, 10, 26, 10, 42]);
+  const worldText = Buffer.from("Texto de documentación con tildes: Ámbar.");
+  const magicText = Buffer.from("Notas del sistema de magia.");
+  state.characters = [{ id: "character-one", name: "Personaje de prueba", imageUrl: `data:image/png;base64,${photo.toString("base64")}` }];
+  state.world = [{ id: "world-one", name: "Puerto de prueba", attachments: [{ id: "world-attachment", name: "notas.txt", mimeType: "text/plain", size: worldText.length, kind: "text", dataUrl: `data:text/plain;base64,${worldText.toString("base64")}` }] }];
+  state.magicSystems = [{ id: "magic-one", name: "Sistema de prueba", attachments: [{ id: "magic-attachment", name: "magia.txt", mimeType: "text/plain", size: magicText.length, kind: "text", dataUrl: `data:text/plain;base64,${magicText.toString("base64")}` }] }];
+  const before = structuredClone(state);
+  const blob = await createWbwPackage(state, "project-existing");
+  const imported = await readWbwPackage(new File([blob], "Recursos.wbw", { type: WBW_MIME }));
+  assert.equal(imported.assets.length, 3);
+  const expected = new Map([["character-photo", photo], ["world", worldText], ["magic", magicText]]);
+  for (const asset of imported.assets) {
+    const key = asset.descriptor.kind === "character-photo" ? "character-photo" : asset.descriptor.scope;
+    assert.deepEqual(Buffer.from(await asset.file.arrayBuffer()), expected.get(key));
+  }
+  assert.deepEqual(imported.state.writingChapters, before.writingChapters);
+  assert.deepEqual(state, before);
+});
+
+test("a missing resource rejects export and leaves the existing project untouched", async () => {
+  const state = existingProject();
+  state.characters = [{ id: "missing-character", name: "Foto faltante", imageUrl: "/missing-photo.png" }];
+  const before = structuredClone(state);
+  const originalFetch = globalThis.fetch;
+  globalThis.fetch = async () => new Response("Missing", { status: 404 });
+  try {
+    await assert.rejects(createWbwPackage(state, "project-existing"), /No se pudo incorporar/u);
+    assert.deepEqual(state, before);
+  } finally {
+    globalThis.fetch = originalFetch;
+  }
+});
