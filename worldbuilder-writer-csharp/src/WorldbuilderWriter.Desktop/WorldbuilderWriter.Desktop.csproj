<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>WorldbuilderWriter.Desktop</RootNamespace>
    <AssemblyName>WorldbuilderWriter</AssemblyName>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <Product>Worldbuilder Writer</Product>
    <Description>Editor local de escritura y creación de mundos.</Description>
    <Version>0.1.0</Version>
    <FileVersion>0.1.0.0</FileVersion>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WorldbuilderWriter.Core\WorldbuilderWriter.Core.csproj" />
    <ProjectReference Include="..\WorldbuilderWriter.Infrastructure\WorldbuilderWriter.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Assets\app-icon.svg" />
  </ItemGroup>
</Project>
