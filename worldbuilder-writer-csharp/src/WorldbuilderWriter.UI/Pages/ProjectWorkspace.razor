@page "/project/{Id}"
@inject IProjectRepository Projects
@inject IManuscriptImportService ManuscriptImporter
@inject NavigationManager Navigation

<PageTitle>@(Project?.Profile.ArchiveTitle ?? "Proyecto") · Worldbuilder Writer</PageTitle>

@if (Loading)
{
    <div class="loading-screen"><span>◇</span><p>Abriendo el archivo externo…</p></div>
}
else if (Project is null)
{
    <div class="loading-screen"><h1>No se pudo abrir el proyecto</h1><p>@StatusMessage</p><a class="primary" href="/">Volver a la biblioteca</a></div>
}
else if (Project is { } project)
{
    <section class="workspace-shell @ThemeClass">
        <aside class="workspace-nav">
            <a class="workspace-brand" href="/"><span>WW</span><strong>@project.Profile.ArchiveTitle</strong><small>@project.Profile.Status</small></a>
            <nav>
                <button class="@(ActiveArea == WorkspaceArea.Board ? "active" : "")" type="button" @onclick="() => ActiveArea = WorkspaceArea.Board"><span>01</span><strong>Tablero</strong><small>Personajes y relaciones</small></button>
                <button class="@(ActiveArea == WorkspaceArea.Manuscript ? "active" : "")" type="button" @onclick="() => ActiveArea = WorkspaceArea.Manuscript"><span>02</span><strong>Manuscrito</strong><small>Capítulos y escenas</small></button>
                <button class="@(ActiveArea == WorkspaceArea.World ? "active" : "")" type="button" @onclick="() => ActiveArea = WorkspaceArea.World"><span>03</span><strong>Creación de mundo</strong><small>Mundo, magia y cronología</small></button>
            </nav>
            <div class="nav-foot"><span>PROYECTO EXTERNO</span><code>@project.Id</code><a href="/">← Biblioteca</a></div>
        </aside>

        <div class="workspace-main">
            <header class="workspace-header">
                <div><span class="eyebrow">@AreaEyebrow</span><h1>@AreaTitle</h1></div>
                <div class="workspace-actions">
                    <label class="theme-select"><span>Tema</span><select @bind="project.Profile.Theme"><option value="grim">Fantasía sucia</option><option value="classic">Fantasía clásica</option><option value="kawaii">Moe kawaii</option><option value="chronicle">Crónica</option><option value="desk">Escritorio</option></select></label>
                    <button class="secondary" type="button" @onclick="OpenProjectSettings">Datos de la obra</button>
                    <button class="primary" type="button" @onclick="SaveAsync" disabled="@Saving">@(Saving ? "Guardando…" : "Guardar proyecto")</button>
                </div>
            </header>

            @if (!string.IsNullOrWhiteSpace(StatusMessage))
            {
                <div class="workspace-status">@StatusMessage<button type="button" @onclick="() => StatusMessage = string.Empty">×</button></div>
            }

            @switch (ActiveArea)
            {
                case WorkspaceArea.Board:
                    @BoardView()
                    break;
                case WorkspaceArea.Manuscript:
                    @ManuscriptView()
                    break;
                case WorkspaceArea.World:
                    @WorldView()
                    break;
            }
        </div>
    </section>
}

@if (ShowSettings && Project is { } settingsProject)
{
    <div class="modal-backdrop">
        <section class="sheet-dialog wide" role="dialog" aria-modal="true" aria-labelledby="settings-title">
            <header><div><span class="eyebrow">CONFIGURACIÓN EDITABLE</span><h2 id="settings-title">Datos de la obra</h2></div><button type="button" @onclick="() => ShowSettings = false">×</button></header>
            <div class="form-grid">
                <label><span>Nombre del archivo</span><input @bind="settingsProject.Profile.ArchiveTitle" /></label>
                <label><span>Título de la historia</span><input @bind="settingsProject.Profile.StoryTitle" /></label>
                <label><span>Subtítulo</span><input @bind="settingsProject.Profile.Subtitle" /></label>
                <label><span>Autor</span><input @bind="settingsProject.Profile.Author" /></label>
                <label><span>Género</span><input @bind="settingsProject.Profile.Genre" /></label>
                <label><span>Estado</span><select @bind="settingsProject.Profile.Status"><option>Planificación</option><option>Escritura</option><option>Revisión</option><option>Final</option></select></label>
                <label class="span-all"><span>Sinopsis</span><textarea rows="6" @bind="settingsProject.Profile.Synopsis"></textarea></label>
            </div>
            <footer><button class="secondary" type="button" @onclick="() => ShowSettings = false">Cerrar</button><button class="primary" type="button" @onclick="SaveSettingsAsync">Guardar datos</button></footer>
        </section>
    </div>
}

@if (PendingDelete is { } pendingDelete)
{
    <div class="modal-backdrop">
        <section class="confirm-dialog" role="dialog" aria-modal="true" aria-labelledby="delete-title">
            <span class="eyebrow">CONFIRMACIÓN</span>
            <h3 id="delete-title">@pendingDelete.Question</h3>
            <p>@pendingDelete.Warning</p>
            <div><button class="secondary" type="button" @onclick="CancelDelete">Cancelar</button><button class="danger" type="button" @onclick="ConfirmDeleteAsync">Eliminar</button></div>
        </section>
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = "";

    private StoryProject? Project { get; set; }
    private WorkspaceArea ActiveArea { get; set; } = WorkspaceArea.Board;
    private ManuscriptMode CurrentManuscriptMode { get; set; } = ManuscriptMode.Write;
    private WorldSection CurrentWorldSection { get; set; } = WorldSection.World;
    private string SelectedChapterId { get; set; } = "";
    private string SelectedSceneId { get; set; } = "";
    private string SelectedCharacterId { get; set; } = "";
    private string DraggedChapterId { get; set; } = "";
    private string DraggedSceneId { get; set; } = "";
    private string DraggedSceneChapterId { get; set; } = "";
    private double BoardZoom { get; set; } = 1;
    private double SceneZoom { get; set; } = 1;
    private bool Loading { get; set; } = true;
    private bool Saving { get; set; }
    private bool Importing { get; set; }
    private bool ShowSettings { get; set; }
    private string StatusMessage { get; set; } = "";
    private DeleteRequest? PendingDelete { get; set; }
    private CharacterRecord CharacterDraft { get; set; } = new();
    private RelationshipRecord RelationshipDraft { get; set; } = new();
    private WorldEntry WorldDraft { get; set; } = new();
    private MagicSystem MagicDraft { get; set; } = new();
    private TimelineEvent TimelineDraft { get; set; } = new();

    private IReadOnlyList<WritingChapter> OrderedChapters => Project?.Chapters.OrderBy(chapter => chapter.Order).ToArray() ?? [];
    private WritingChapter? SelectedChapter => OrderedChapters.FirstOrDefault(chapter => chapter.Id == SelectedChapterId) ?? OrderedChapters.FirstOrDefault();
    private WritingScene? SelectedScene => SelectedChapter?.Scenes.OrderBy(scene => scene.Order).FirstOrDefault(scene => scene.Id == SelectedSceneId) ?? SelectedChapter?.Scenes.OrderBy(scene => scene.Order).FirstOrDefault();
    private string ThemeClass => $"theme-{ThemeRules.Normalize(Project?.Profile.Theme)}";
    private string AreaEyebrow => ActiveArea switch { WorkspaceArea.Board => "PERSONAJES / ENLACES", WorkspaceArea.Manuscript => "CAPÍTULOS / ESCENAS", _ => "MUNDO / MAGIA / CRONOLOGÍA" };
    private string AreaTitle => ActiveArea switch { WorkspaceArea.Board => "Tablero", WorkspaceArea.Manuscript => "Manuscrito", _ => "Creación de mundo" };

    protected override async Task OnParametersSetAsync()
    {
        Loading = true;
        try
        {
            Project = await Projects.OpenAsync(Id);
            EnsureSelection();
        }
        catch (Exception error) when (error is IOException or UnauthorizedAccessException or InvalidDataException or JsonException)
        {
            Project = null;
            StatusMessage = error.Message;
        }
        finally
        {
            Loading = false;
        }
    }

    private RenderFragment BoardView() => @<section class="board-workspace">
            @{ var boardProject = Project!; }
            <div class="board-toolbar">
                <div><button type="button" @onclick="() => BoardZoom = Math.Max(.4, BoardZoom - .1)">−</button><span>@($"{BoardZoom:P0}")</span><button type="button" @onclick="() => BoardZoom = Math.Min(2, BoardZoom + .1)">+</button><button type="button" @onclick="() => BoardZoom = 1">100%</button></div>
                <p>Los tipos de relación controlan color y trazo. Conocidos e interacciones lejanas usan líneas segmentadas.</p>
            </div>
            <div class="relationship-layout">
                <aside class="board-forms">
                    <details open>
                        <summary>+ Personaje</summary>
                        <div class="compact-form"><label><span>Nombre</span><input @bind="CharacterDraft.Name" /></label><label><span>Rol</span><input @bind="CharacterDraft.Role" /></label><label><span>Resumen</span><textarea rows="3" @bind="CharacterDraft.Summary"></textarea></label><button class="primary" type="button" @onclick="AddCharacter">Agregar al tablero</button></div>
                    </details>
                    <details open>
                        <summary>+ Enlace manual</summary>
                        <div class="compact-form"><label><span>Origen</span><select @bind="RelationshipDraft.SourceId"><option value="">Seleccionar…</option>@foreach (var character in boardProject.Characters) { <option value="@character.Id">@character.Name</option> }</select></label><label><span>Destino</span><select @bind="RelationshipDraft.TargetId"><option value="">Seleccionar…</option>@foreach (var character in boardProject.Characters) { <option value="@character.Id">@character.Name</option> }</select></label><label><span>Tipo</span><select @bind="RelationshipDraft.Type">@foreach (var type in RelationshipTypes) { <option>@type</option> }</select></label><label><span>Descripción</span><input @bind="RelationshipDraft.Label" /></label><button class="primary" type="button" @onclick="AddRelationship">Crear enlace</button></div>
                    </details>
                    @if (SelectedCharacter is { } selectedCharacter)
                    {
                        <details open><summary>Ficha seleccionada</summary><div class="compact-form"><label><span>Nombre</span><input @bind="selectedCharacter.Name" /></label><label><span>Rol</span><input @bind="selectedCharacter.Role" /></label><label><span>Antecedentes</span><textarea rows="5" @bind="selectedCharacter.Background"></textarea></label><div class="nudge-grid"><button type="button" @onclick="() => MoveCharacter(selectedCharacter, 0, -25)">↑</button><button type="button" @onclick="() => MoveCharacter(selectedCharacter, -25, 0)">←</button><button type="button" @onclick="() => MoveCharacter(selectedCharacter, 25, 0)">→</button><button type="button" @onclick="() => MoveCharacter(selectedCharacter, 0, 25)">↓</button></div><button class="danger-link" type="button" @onclick="() => AskDeleteCharacter(selectedCharacter)">Eliminar personaje</button></div></details>
                    }
                </aside>
                <div class="relationship-board-viewport">
                    <svg class="relationship-board" viewBox="0 0 1400 820" style="transform:scale(@BoardZoom.ToString(CultureInfo.InvariantCulture));transform-origin:0 0">
                        @foreach (var link in boardProject.Relationships)
                        {
                            var source = boardProject.Characters.FirstOrDefault(character => character.Id == link.SourceId);
                            var target = boardProject.Characters.FirstOrDefault(character => character.Id == link.TargetId);
                            if (source is null || target is null) continue;
                            <line x1="@(source.X + 90)" y1="@(source.Y + 35)" x2="@(target.X + 90)" y2="@(target.Y + 35)" stroke="@RelationshipColor(link.Type)" stroke-width="@(1.5 + link.Strength)" stroke-dasharray="@RelationshipDash(link.Type)" />
                        }
                        @foreach (var character in boardProject.Characters)
                        {
                            <g class="character-node @(SelectedCharacterId == character.Id ? "selected" : "")" transform="translate(@character.X.ToString(CultureInfo.InvariantCulture) @character.Y.ToString(CultureInfo.InvariantCulture))" @onclick="() => SelectedCharacterId = character.Id">
                                <rect width="180" height="72" rx="3"></rect><text x="14" y="28">@character.Name</text><text class="node-role" x="14" y="51">@(string.IsNullOrWhiteSpace(character.Role) ? "Sin rol" : character.Role)</text>
                            </g>
                        }
                    </svg>
                </div>
            </div>
        </section>;

    private RenderFragment ManuscriptView() => @<section class="manuscript-workspace">
            @{ var manuscriptProject = Project!; var currentChapter = SelectedChapter; var currentScene = SelectedScene; }
            <div class="manuscript-topbar">
                <div class="segmented"><button class="@(CurrentManuscriptMode == ManuscriptMode.Write ? "active" : "")" type="button" @onclick="() => CurrentManuscriptMode = ManuscriptMode.Write">Escritura</button><button class="@(CurrentManuscriptMode == ManuscriptMode.Board ? "active" : "")" type="button" @onclick="() => CurrentManuscriptMode = ManuscriptMode.Board">Tablero de escenas</button></div>
                <span>@manuscriptProject.Chapters.Count capítulos · @manuscriptProject.Chapters.Sum(chapter => chapter.Scenes.Count) escenas · @TotalWords.ToString("N0", CultureInfo.InvariantCulture) palabras</span>
                <label class="import-button"><InputFile OnChange="ImportManuscriptAsync" accept=".docx,.txt,.md" disabled="@Importing" /><span>@(Importing ? "Importando…" : "Importar DOCX o texto")</span></label>
                <button class="primary" type="button" @onclick="AddChapter">+ Capítulo</button>
            </div>

            @if (CurrentManuscriptMode == ManuscriptMode.Board)
            {
                <div class="scene-board-toolbar"><div><button type="button" @onclick="() => SceneZoom = Math.Max(.45, SceneZoom - .1)">−</button><span>@($"{SceneZoom:P0}")</span><button type="button" @onclick="() => SceneZoom = Math.Min(1.8, SceneZoom + .1)">+</button><button type="button" @onclick="() => SceneZoom = 1">100%</button></div><p>Arrastra encabezados para reordenar capítulos y tarjetas para mover escenas.</p></div>
                <div class="scene-board-viewport">
                    <div class="scene-board-world" style="transform:scale(@SceneZoom.ToString(CultureInfo.InvariantCulture));transform-origin:0 0">
                        @foreach (var chapter in OrderedChapters)
                        {
                            <section class="scene-column" @ondragover:preventDefault @ondrop="() => DropOnChapter(chapter.Id)">
                                <header draggable="true" @ondragstart="() => BeginChapterDrag(chapter.Id)" @ondragend="ClearDrag"><span>@chapter.Label</span><h3>@chapter.Title</h3><small>@chapter.Scenes.Count escenas · @ChapterWords(chapter) palabras</small></header>
                                <div>@foreach (var scene in chapter.Scenes.OrderBy(scene => scene.Order)) { <article class="scene-card status-@scene.Status.ToLowerInvariant()" draggable="true" @ondragstart="() => BeginSceneDrag(chapter.Id, scene.Id)" @ondragend="ClearDrag" @ondblclick="() => OpenScene(chapter.Id, scene.Id)"><span>@(string.IsNullOrWhiteSpace(scene.NarrativeLayer) ? "Sin capa" : scene.NarrativeLayer)</span><h4>@scene.Title</h4><p>@(string.IsNullOrWhiteSpace(scene.Pov) ? "POV sin definir" : $"POV · {scene.Pov}")</p><small>@WordCount(scene.Content) palabras · @scene.Status</small></article> }</div>
                            </section>
                        }
                    </div>
                    <div class="scene-trash" @ondragover:preventDefault @ondrop="AskDeleteDragged"><strong>⌫ PAPELERA</strong><span>Arrastra aquí una escena o capítulo</span></div>
                </div>
            }
            else
            {
                <div class="manuscript-layout">
                    <aside class="chapter-index">
                        <header><span>ÍNDICE</span><details><summary>Eliminar</summary><div><button type="button" disabled="@(currentScene is null)" @onclick="AskDeleteCurrentScene">Escena actual</button><button type="button" disabled="@(currentChapter is null)" @onclick="AskDeleteCurrentChapter">Capítulo actual</button><button type="button" disabled="@(manuscriptProject.Chapters.Count == 0)" @onclick="AskPurgeChapters">Purgar capítulos</button></div></details></header>
                        @foreach (var chapter in OrderedChapters)
                        {
                            <section class="@(SelectedChapter?.Id == chapter.Id ? "active" : "")"><button class="chapter-button" type="button" @onclick="() => SelectChapter(chapter)"><span>@chapter.Label <i>@chapter.Scenes.Count escenas</i></span><strong>@chapter.Title</strong><small>@ChapterWords(chapter) palabras</small></button>@if (SelectedChapter?.Id == chapter.Id) { <div class="scene-list">@foreach (var scene in chapter.Scenes.OrderBy(scene => scene.Order)) { <button class="@(SelectedScene?.Id == scene.Id ? "active" : "")" type="button" @onclick="() => SelectScene(chapter, scene)"><span>@scene.Title</span><small>@scene.Status</small></button> }<button class="new-scene" type="button" @onclick="AddScene">+ Nueva escena</button></div> }</section>
                        }
                    </aside>
                    @if (currentChapter is not null && currentScene is not null)
                    {
                        <article class="scene-editor">
                            <header><div><span class="eyebrow">EDITOR DE ESCENA</span><strong>@currentChapter.Title · @currentScene.Title</strong></div><button class="primary" type="button" @onclick="SaveAsync">Guardar escena</button></header>
                            <div class="scene-fields"><label><span>Capítulo</span><input @bind="currentChapter.Label" /></label><label><span>Título del capítulo</span><input @bind="currentChapter.Title" /></label><label><span>Título de escena</span><input @bind="currentScene.Title" /></label><label><span>POV</span><input @bind="currentScene.Pov" /></label><label><span>Ubicación</span><input @bind="currentScene.Location" /></label><label><span>Capa narrativa</span><input @bind="currentScene.NarrativeLayer" /></label><label><span>Estado</span><select @bind="currentScene.Status"><option>Borrador</option><option>Revisión</option><option>Final</option></select></label></div>
                            <textarea class="writing-surface" @bind="currentScene.Content" @bind:event="oninput" spellcheck="true" lang="es" placeholder="Escribe aquí…"></textarea>
                            <footer><span>@WordCount(currentScene.Content) palabras</span><small>Un renglón vacío importado se interpreta como salto de escena.</small></footer>
                        </article>
                    }
                    else
                    {
                        <div class="empty-editor"><span>✎</span><h3>Tu manuscrito comienza aquí</h3><button class="primary" type="button" @onclick="AddChapter">Crear primer capítulo</button></div>
                    }
                </div>
            }
        </section>;

    private RenderFragment WorldView() => @<section class="world-workspace">
            @{ var worldProject = Project!; }
            <div class="world-tabs"><button class="@(CurrentWorldSection == WorldSection.World ? "active" : "")" type="button" @onclick="() => CurrentWorldSection = WorldSection.World">Mundo</button><button class="@(CurrentWorldSection == WorldSection.Magic ? "active" : "")" type="button" @onclick="() => CurrentWorldSection = WorldSection.Magic">Sistemas de magia</button><button class="@(CurrentWorldSection == WorldSection.Timeline ? "active" : "")" type="button" @onclick="() => CurrentWorldSection = WorldSection.Timeline">Cronología</button></div>
            @if (CurrentWorldSection == WorldSection.World)
            {
                <div class="creation-layout"><aside class="creation-form"><span class="eyebrow">NUEVA ENTRADA</span><label><span>Tipo</span><select @bind="WorldDraft.Category"><option>País o reino</option><option>Ciudad</option><option>Moneda</option><option>Religión</option><option>Cultura</option><option>Organización</option><option>Objeto</option><option>Fauna o criatura</option><option>Otro</option></select></label><label><span>Nombre</span><input @bind="WorldDraft.Name" /></label><label><span>Resumen</span><textarea rows="4" @bind="WorldDraft.Summary"></textarea></label><label><span>Detalles</span><textarea rows="7" @bind="WorldDraft.Details"></textarea></label><button class="primary" type="button" @onclick="AddWorldEntry">Agregar</button></aside><div class="creation-grid">@foreach (var entry in worldProject.World) { <article><span>@entry.Category</span><input @bind="entry.Name" /><textarea rows="3" @bind="entry.Summary"></textarea><details><summary>Detalles</summary><textarea rows="8" @bind="entry.Details"></textarea></details><button class="danger-link" type="button" @onclick="() => worldProject.World.Remove(entry)">Eliminar</button></article> }</div></div>
            }
            else if (CurrentWorldSection == WorldSection.Magic)
            {
                <div class="creation-layout"><aside class="creation-form"><span class="eyebrow">NUEVO SISTEMA</span><label><span>Nombre</span><input @bind="MagicDraft.Name" /></label><label><span>Fuente</span><textarea rows="3" @bind="MagicDraft.Source"></textarea></label><label><span>Reglas</span><textarea rows="5" @bind="MagicDraft.Rules"></textarea></label><label><span>Costes</span><textarea rows="3" @bind="MagicDraft.Costs"></textarea></label><label><span>Límites</span><textarea rows="3" @bind="MagicDraft.Limits"></textarea></label><button class="primary" type="button" @onclick="AddMagicSystem">Agregar</button></aside><div class="creation-grid">@foreach (var system in worldProject.MagicSystems) { <article><span>SISTEMA DE MAGIA</span><input @bind="system.Name" /><label><small>Fuente</small><textarea rows="3" @bind="system.Source"></textarea></label><label><small>Reglas</small><textarea rows="5" @bind="system.Rules"></textarea></label><label><small>Costes y límites</small><textarea rows="4" @bind="system.Costs"></textarea><textarea rows="4" @bind="system.Limits"></textarea></label><button class="danger-link" type="button" @onclick="() => worldProject.MagicSystems.Remove(system)">Eliminar</button></article> }</div></div>
            }
            else
            {
                <div class="creation-layout"><aside class="creation-form"><span class="eyebrow">NUEVO EVENTO</span><label><span>Cuándo</span><input @bind="TimelineDraft.When" /></label><label><span>Título</span><input @bind="TimelineDraft.Title" /></label><label><span>Capítulo</span><input @bind="TimelineDraft.Chapter" /></label><label><span>Descripción</span><textarea rows="6" @bind="TimelineDraft.Summary"></textarea></label><button class="primary" type="button" @onclick="AddTimelineEvent">Agregar</button></aside><div class="timeline-list">@foreach (var item in worldProject.Timeline.OrderBy(item => item.Order)) { <article><i></i><div><span>@item.When · @item.Chapter</span><input @bind="item.Title" /><textarea rows="3" @bind="item.Summary"></textarea><button class="danger-link" type="button" @onclick="() => worldProject.Timeline.Remove(item)">Eliminar</button></div></article> }</div></div>
            }
        </section>;

    private CharacterRecord? SelectedCharacter => Project?.Characters.FirstOrDefault(character => character.Id == SelectedCharacterId);
    private static readonly string[] RelationshipTypes = ["Familia", "Amistad", "Romance", "Alianza", "Enemistad", "Rivalidad", "Conocido", "Interacción"];
    private int TotalWords => Project?.Chapters.Sum(ChapterWords) ?? 0;

    private async Task SaveAsync()
    {
        if (Project is null || Saving) return;
        Saving = true;
        try
        {
            NormalizeWritingOrder();
            Project.Profile.Theme = ThemeRules.Normalize(Project.Profile.Theme);
            await Projects.SaveAsync(Project);
            StatusMessage = $"Guardado a las {DateTime.Now:HH:mm:ss}.";
        }
        catch (Exception error) when (error is IOException or UnauthorizedAccessException or InvalidDataException)
        {
            StatusMessage = error.Message;
        }
        finally
        {
            Saving = false;
        }
    }

    private void OpenProjectSettings() => ShowSettings = true;
    private async Task SaveSettingsAsync() { ShowSettings = false; await SaveAsync(); }

    private void AddCharacter()
    {
        if (Project is null) return;
        CharacterDraft.X = 80 + Project.Characters.Count % 5 * 235;
        CharacterDraft.Y = 90 + Project.Characters.Count / 5 * 140;
        Project.Characters.Add(CharacterDraft);
        SelectedCharacterId = CharacterDraft.Id;
        CharacterDraft = new CharacterRecord();
    }

    private void AddRelationship()
    {
        if (Project is null || string.IsNullOrWhiteSpace(RelationshipDraft.SourceId) || string.IsNullOrWhiteSpace(RelationshipDraft.TargetId) || RelationshipDraft.SourceId == RelationshipDraft.TargetId) { StatusMessage = "Elige dos personajes distintos para crear el enlace."; return; }
        Project.Relationships.Add(RelationshipDraft);
        RelationshipDraft = new RelationshipRecord();
    }

    private static string RelationshipColor(string type) => type switch { "Familia" => "#c89b45", "Amistad" => "#a74739", "Romance" => "#be5b69", "Enemistad" or "Rivalidad" => "#692a33", "Alianza" => "#4f7868", "Conocido" => "#746d86", _ => "#8e7b63" };
    private static string RelationshipDash(string type) => type is "Conocido" or "Interacción" ? "10 8" : "";
    private static void MoveCharacter(CharacterRecord character, double x, double y) { character.X = Math.Clamp(character.X + x, 0, 1210); character.Y = Math.Clamp(character.Y + y, 0, 740); }

    private void AddChapter()
    {
        if (Project is null) return;
        var chapter = new WritingChapter { Label = $"Capítulo {Project.Chapters.Count + 1}", Order = Project.Chapters.Count };
        var scene = new WritingScene { ChapterId = chapter.Id };
        chapter.Scenes.Add(scene);
        Project.Chapters.Add(chapter);
        SelectScene(chapter, scene);
        CurrentManuscriptMode = ManuscriptMode.Write;
    }

    private void AddScene()
    {
        var chapter = SelectedChapter;
        if (chapter is null) { AddChapter(); return; }
        var scene = new WritingScene { ChapterId = chapter.Id, Order = chapter.Scenes.Count, Title = $"Escena {chapter.Scenes.Count + 1}" };
        chapter.Scenes.Add(scene);
        SelectScene(chapter, scene);
    }

    private void SelectChapter(WritingChapter chapter)
    {
        SelectedChapterId = chapter.Id;
        SelectedSceneId = chapter.Scenes.OrderBy(scene => scene.Order).FirstOrDefault()?.Id ?? "";
    }

    private void SelectScene(WritingChapter chapter, WritingScene scene) { SelectedChapterId = chapter.Id; SelectedSceneId = scene.Id; }
    private void OpenScene(string chapterId, string sceneId) { SelectedChapterId = chapterId; SelectedSceneId = sceneId; CurrentManuscriptMode = ManuscriptMode.Write; }

    private async Task ImportManuscriptAsync(InputFileChangeEventArgs eventArgs)
    {
        if (Project is null || Importing) return;
        Importing = true;
        StatusMessage = "";
        try
        {
            var file = eventArgs.File;
            await using var stream = file.OpenReadStream(8 * 1024 * 1024);
            var imported = await ManuscriptImporter.ImportAsync(stream, file.Name, Project.Chapters.Count);
            Project.Chapters.AddRange(imported.Chapters);
            NormalizeWritingOrder();
            var first = imported.Chapters.FirstOrDefault();
            if (first is not null) SelectChapter(first);
            await SaveAsync();
            StatusMessage = $"Se importaron {imported.Chapters.Count} capítulos y {imported.Chapters.Sum(chapter => chapter.Scenes.Count)} escenas desde “{file.Name}”.";
        }
        catch (Exception error) when (error is IOException or InvalidDataException)
        {
            StatusMessage = error.Message;
        }
        finally
        {
            Importing = false;
        }
    }

    private void BeginChapterDrag(string chapterId) { DraggedChapterId = chapterId; DraggedSceneId = ""; DraggedSceneChapterId = ""; }
    private void BeginSceneDrag(string chapterId, string sceneId) { DraggedChapterId = ""; DraggedSceneChapterId = chapterId; DraggedSceneId = sceneId; }
    private void ClearDrag() { DraggedChapterId = ""; DraggedSceneId = ""; DraggedSceneChapterId = ""; }

    private void DropOnChapter(string targetChapterId)
    {
        if (Project is null) return;
        if (!string.IsNullOrWhiteSpace(DraggedSceneId))
        {
            var source = Project.Chapters.FirstOrDefault(chapter => chapter.Id == DraggedSceneChapterId);
            var target = Project.Chapters.FirstOrDefault(chapter => chapter.Id == targetChapterId);
            var scene = source?.Scenes.FirstOrDefault(scene => scene.Id == DraggedSceneId);
            if (source is not null && target is not null && scene is not null) { source.Scenes.Remove(scene); scene.ChapterId = target.Id; target.Scenes.Add(scene); }
        }
        else if (!string.IsNullOrWhiteSpace(DraggedChapterId) && DraggedChapterId != targetChapterId)
        {
            var ordered = OrderedChapters.ToList();
            var moving = ordered.FirstOrDefault(chapter => chapter.Id == DraggedChapterId);
            var targetIndex = ordered.FindIndex(chapter => chapter.Id == targetChapterId);
            if (moving is not null && targetIndex >= 0) { ordered.Remove(moving); ordered.Insert(Math.Min(targetIndex, ordered.Count), moving); Project.Chapters = ordered; }
        }
        NormalizeWritingOrder();
        ClearDrag();
    }

    private void AskDeleteDragged()
    {
        if (!string.IsNullOrWhiteSpace(DraggedSceneId))
        {
            var chapter = Project?.Chapters.FirstOrDefault(item => item.Id == DraggedSceneChapterId);
            var scene = chapter?.Scenes.FirstOrDefault(item => item.Id == DraggedSceneId);
            if (chapter is not null && scene is not null) PendingDelete = DeleteRequest.Scene(chapter, scene);
        }
        else if (!string.IsNullOrWhiteSpace(DraggedChapterId))
        {
            var chapter = Project?.Chapters.FirstOrDefault(item => item.Id == DraggedChapterId);
            if (chapter is not null) PendingDelete = DeleteRequest.Chapter(chapter);
        }
        ClearDrag();
    }

    private void AskDeleteCurrentScene() { if (SelectedChapter is not null && SelectedScene is not null) PendingDelete = DeleteRequest.Scene(SelectedChapter, SelectedScene); }
    private void AskDeleteCurrentChapter() { if (SelectedChapter is not null) PendingDelete = DeleteRequest.Chapter(SelectedChapter); }
    private void AskPurgeChapters() { if (Project is not null) PendingDelete = DeleteRequest.Purge(Project.Chapters.Count, Project.Chapters.Sum(chapter => chapter.Scenes.Count)); }
    private void AskDeleteCharacter(CharacterRecord character) => PendingDelete = DeleteRequest.Character(character);
    private void CancelDelete() => PendingDelete = null;

    private async Task ConfirmDeleteAsync()
    {
        if (Project is null || PendingDelete is null) return;
        var request = PendingDelete;
        PendingDelete = null;
        switch (request.Kind)
        {
            case DeleteKind.Scene:
                Project.Chapters.FirstOrDefault(chapter => chapter.Id == request.ParentId)?.Scenes.RemoveAll(scene => scene.Id == request.TargetId);
                break;
            case DeleteKind.Chapter:
                Project.Chapters.RemoveAll(chapter => chapter.Id == request.TargetId);
                break;
            case DeleteKind.Character:
                Project.Characters.RemoveAll(character => character.Id == request.TargetId);
                Project.Relationships.RemoveAll(link => link.SourceId == request.TargetId || link.TargetId == request.TargetId);
                break;
            case DeleteKind.Purge:
                Project.Chapters.Clear();
                break;
        }
        NormalizeWritingOrder();
        EnsureSelection();
        await SaveAsync();
    }

    private void AddWorldEntry() { Project?.World.Add(WorldDraft); WorldDraft = new WorldEntry(); }
    private void AddMagicSystem() { Project?.MagicSystems.Add(MagicDraft); MagicDraft = new MagicSystem(); }
    private void AddTimelineEvent() { if (Project is null) return; TimelineDraft.Order = Project.Timeline.Count; Project.Timeline.Add(TimelineDraft); TimelineDraft = new TimelineEvent(); }

    private void NormalizeWritingOrder()
    {
        if (Project is null) return;
        var chapters = Project.Chapters.OrderBy(chapter => chapter.Order).ToList();
        for (var chapterIndex = 0; chapterIndex < chapters.Count; chapterIndex++)
        {
            chapters[chapterIndex].Order = chapterIndex;
            var scenes = chapters[chapterIndex].Scenes.OrderBy(scene => scene.Order).ToList();
            for (var sceneIndex = 0; sceneIndex < scenes.Count; sceneIndex++) { scenes[sceneIndex].Order = sceneIndex; scenes[sceneIndex].ChapterId = chapters[chapterIndex].Id; }
            chapters[chapterIndex].Scenes = scenes;
        }
        Project.Chapters = chapters;
    }

    private void EnsureSelection()
    {
        var chapter = Project?.Chapters.OrderBy(chapter => chapter.Order).FirstOrDefault(chapter => chapter.Id == SelectedChapterId) ?? Project?.Chapters.OrderBy(chapter => chapter.Order).FirstOrDefault();
        SelectedChapterId = chapter?.Id ?? "";
        var scene = chapter?.Scenes.OrderBy(scene => scene.Order).FirstOrDefault(scene => scene.Id == SelectedSceneId) ?? chapter?.Scenes.OrderBy(scene => scene.Order).FirstOrDefault();
        SelectedSceneId = scene?.Id ?? "";
        if (Project is not null && Project.Characters.All(character => character.Id != SelectedCharacterId)) SelectedCharacterId = Project.Characters.FirstOrDefault()?.Id ?? "";
    }

    private static int ChapterWords(WritingChapter chapter) => chapter.Scenes.Sum(scene => WordCount(scene.Content));
    private static int WordCount(string? text) => string.IsNullOrWhiteSpace(text) ? 0 : Regex.Matches(text, @"[\p{L}\p{N}]+(?:['’’-][\p{L}\p{N}]+)*").Count;

    private enum WorkspaceArea { Board, Manuscript, World }
    private enum ManuscriptMode { Write, Board }
    private enum WorldSection { World, Magic, Timeline }
    private enum DeleteKind { Scene, Chapter, Character, Purge }
    private sealed record DeleteRequest(DeleteKind Kind, string TargetId, string ParentId, string Question, string Warning)
    {
        public static DeleteRequest Scene(WritingChapter chapter, WritingScene scene) => new(DeleteKind.Scene, scene.Id, chapter.Id, $"¿Eliminar la escena “{scene.Title}”?", "El texto de la escena se eliminará de forma permanente.");
        public static DeleteRequest Chapter(WritingChapter chapter) => new(DeleteKind.Chapter, chapter.Id, "", $"¿Eliminar {chapter.Label}: “{chapter.Title}”?", $"También se eliminarán sus {chapter.Scenes.Count} escenas.");
        public static DeleteRequest Character(CharacterRecord character) => new(DeleteKind.Character, character.Id, "", $"¿Eliminar a “{character.Name}”?", "También se quitarán todas sus relaciones del tablero.");
        public static DeleteRequest Purge(int chapters, int scenes) => new(DeleteKind.Purge, "", "", $"¿Purgar los {chapters} capítulos?", $"Se eliminarán también sus {scenes} escenas. Esta acción no se puede deshacer.");
    }
}
