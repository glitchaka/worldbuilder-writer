@page "/"
@inject IProjectRepository Projects
@inject NavigationManager Navigation

<PageTitle>Worldbuilder Writer</PageTitle>

<section class="library-shell theme-grim">
    <aside class="library-aside">
        <div>
            <span class="eyebrow">ARCHIVO EXTERNO</span>
            <h1>Worldbuilder<br />Writer</h1>
            <p>Cada obra vive fuera de la aplicación. Copiar el programa no copia tus historias.</p>
        </div>
        <div class="root-path"><span>CARPETA DE PROYECTOS</span><code>@Projects.RootPath</code></div>
    </aside>

    <div class="library-content">
        <header class="library-heading">
            <div><span class="eyebrow">BIBLIOTECA</span><h2>Tus historias</h2><p>Abre una obra o comienza una carpeta completamente vacía.</p></div>
            <button class="secondary" type="button" @onclick="LoadAsync">Actualizar</button>
        </header>

        <div class="new-project-panel">
            <label><span>Nombre del proyecto</span><input @bind="NewTitle" placeholder="Nueva obra" /></label>
            <label><span>Tema inicial</span><select @bind="NewTheme"><option value="grim">Fantasía sucia</option><option value="classic">Fantasía clásica</option><option value="kawaii">Moe kawaii</option><option value="chronicle">Crónica</option><option value="desk">Escritorio</option></select></label>
            <button class="primary" type="button" @onclick="CreateAsync" disabled="@Busy">@(Busy ? "Creando…" : "+ Crear proyecto")</button>
        </div>

        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <p class="status-message">@Message</p>
        }

        @if (Busy && Items.Count == 0)
        {
            <div class="empty-state"><h3>Revisando la carpeta…</h3></div>
        }
        else if (Items.Count == 0)
        {
            <div class="empty-state"><span>◇</span><h3>La biblioteca está vacía</h3><p>La aplicación distribuida no incluye proyectos precargados.</p></div>
        }
        else
        {
            <div class="project-grid">
                @foreach (var project in Items)
                {
                    <article class="project-card">
                        <div class="project-card-top"><span>@project.Status</span><i class="theme-chip theme-@project.Theme">@ThemeName(project.Theme)</i></div>
                        <h3>@project.ArchiveTitle</h3>
                        <p>@(string.IsNullOrWhiteSpace(project.StoryTitle) ? "Obra sin título" : project.StoryTitle)</p>
                        <dl><div><dt>@project.Characters</dt><dd>personajes</dd></div><div><dt>@project.Chapters</dt><dd>capítulos</dd></div><div><dt>@project.Scenes</dt><dd>escenas</dd></div></dl>
                        <footer><small>@project.UpdatedAt.LocalDateTime.ToString("dd-MM-yyyy HH:mm", CultureInfo.InvariantCulture)</small><div><button class="danger-link" type="button" @onclick="() => AskDelete(project)">Eliminar</button><button class="primary" type="button" @onclick="() => OpenProject(project)">Abrir →</button></div></footer>
                    </article>
                }
            </div>
        }
    </div>
</section>

@if (PendingDelete is { } pendingDelete)
{
    <div class="modal-backdrop" role="presentation">
        <section class="confirm-dialog" role="dialog" aria-modal="true" aria-labelledby="delete-project-title">
            <span class="eyebrow">ELIMINACIÓN PERMANENTE</span>
            <h3 id="delete-project-title">¿Eliminar “@pendingDelete.ArchiveTitle”?</h3>
            <p>Se eliminará su carpeta externa completa. Esta acción no se puede deshacer.</p>
            <div><button class="secondary" type="button" @onclick="CancelDelete">Cancelar</button><button class="danger" type="button" @onclick="ConfirmDeleteAsync">Eliminar proyecto</button></div>
        </section>
    </div>
}

@code {
    private List<ProjectSummary> Items { get; } = [];
    private string NewTitle { get; set; } = "";
    private string NewTheme { get; set; } = "grim";
    private string Message { get; set; } = "";
    private bool Busy { get; set; }
    private ProjectSummary? PendingDelete { get; set; }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        Busy = true;
        Message = "";
        try
        {
            Items.Clear();
            Items.AddRange(await Projects.ListAsync());
        }
        catch (Exception error) when (error is IOException or UnauthorizedAccessException)
        {
            Message = error.Message;
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task CreateAsync()
    {
        if (Busy) return;
        Busy = true;
        Message = "";
        try
        {
            var project = await Projects.CreateAsync(NewTitle, NewTheme);
            Navigation.NavigateTo($"/project/{project.Id}");
        }
        catch (Exception error) when (error is IOException or UnauthorizedAccessException or InvalidDataException)
        {
            Message = error.Message;
        }
        finally
        {
            Busy = false;
        }
    }

    private void AskDelete(ProjectSummary project) => PendingDelete = project;
    private void OpenProject(ProjectSummary project) => Navigation.NavigateTo($"/project/{project.Id}");
    private void CancelDelete() => PendingDelete = null;

    private async Task ConfirmDeleteAsync()
    {
        if (PendingDelete is null) return;
        await Projects.DeleteAsync(PendingDelete.Id);
        PendingDelete = null;
        await LoadAsync();
    }

    private static string ThemeName(string theme) => theme switch
    {
        "classic" => "Clásica",
        "kawaii" => "Kawaii",
        "chronicle" => "Crónica",
        "desk" => "Escritorio",
        _ => "Fantasía sucia",
    };
}
