<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WorldbuilderWriter.App.MainWindow"
        Title="Worldbuilder Writer"
        Width="1180"
        Height="760"
        MinWidth="880"
        MinHeight="600"
        Background="#17130F"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        Opened="Window_Opened">
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="#3B2A1E" />
      <Setter Property="Foreground" Value="#E8D7B6" />
      <Setter Property="BorderBrush" Value="#785D3A" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="#513522" />
      <Setter Property="BorderBrush" Value="#B58A4B" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#E2CAA0" />
      <Setter Property="Foreground" Value="#261A12" />
      <Setter Property="BorderBrush" Value="#88683F" />
      <Setter Property="CornerRadius" Value="1" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector=".window-button">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector=".window-close:pointerover">
      <Setter Property="Background" Value="#7B2D20" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector=".project-card">
      <Setter Property="Background" Value="#D7BC86" />
      <Setter Property="BorderBrush" Value="#8D6B3F" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style Selector=".muted">
      <Setter Property="Foreground" Value="#A99A84" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="34,*">
    <Border Grid.Row="0" Background="#100D0A" BorderBrush="#3F3022" BorderThickness="0,0,0,1" PointerPressed="Titlebar_PointerPressed">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="9" Margin="12,0,0,0">
          <Border Width="22" Height="22" Background="#7B2D20" BorderBrush="#B58A4B" BorderThickness="1"><TextBlock Text="WW" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#F0D9AF" /></Border>
          <TextBlock Text="WORLDBUILDER WRITER · MIGRACIÓN C#" FontSize="10" LetterSpacing="1.2" Foreground="#B9A789" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Classes="window-button" Content="−" Click="Minimize_Click" ToolTip.Tip="Minimizar" />
          <Button Classes="window-button" Content="□" Click="Maximize_Click" ToolTip.Tip="Maximizar o restaurar" />
          <Button Classes="window-button window-close" Content="×" Click="Close_Click" ToolTip.Tip="Cerrar" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="238,*">
      <Border Background="#251811" BorderBrush="#533A28" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*,Auto" Margin="22">
          <StackPanel Spacing="7">
            <TextBlock Text="WW" FontFamily="Georgia" FontSize="34" Foreground="#C39855" />
            <TextBlock Text="ARCHIVO LOCAL" FontSize="10" LetterSpacing="2" Foreground="#9E8362" />
            <TextBlock Text="Tus historias viven fuera del programa." TextWrapping="Wrap" FontFamily="Georgia" FontSize="15" Foreground="#E1CCAA" Margin="0,8,0,0" />
          </StackPanel>
          <StackPanel Grid.Row="1" Margin="0,38,0,0" Spacing="7">
            <Border Background="#37251A" BorderBrush="#755537" BorderThickness="1" Padding="11"><StackPanel><TextBlock Text="BIBLIOTECA" FontSize="11" Foreground="#E8D7B6" /><TextBlock Text="Primera pantalla nativa" Classes="muted" FontSize="9" /></StackPanel></Border>
            <Border Background="#1E1712" BorderBrush="#473526" BorderThickness="1" Padding="11"><StackPanel><TextBlock Text="REPRODUCTOR" FontSize="11" Foreground="#BBA98C" /><TextBlock Text="Contrato multimedia listo" Classes="muted" FontSize="9" /></StackPanel></Border>
            <Border Background="#1E1712" BorderBrush="#473526" BorderThickness="1" Padding="11"><StackPanel><TextBlock Text="EDITOR" FontSize="11" Foreground="#BBA98C" /><TextBlock Text="Siguiente módulo" Classes="muted" FontSize="9" /></StackPanel></Border>
          </StackPanel>
          <StackPanel Grid.Row="2" Spacing="5">
            <TextBlock Text="CARPETA EXTERNA" FontSize="8" LetterSpacing="1.4" Foreground="#8E785F" />
            <TextBlock Text="{Binding WorkspacePathLabel}" TextWrapping="Wrap" FontSize="10" Foreground="#C8B899" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Column="1" RowDefinitions="Auto,*" Background="#C6A86F">
        <Border Background="#342318" BorderBrush="#735334" BorderThickness="0,0,0,1" Padding="28,18">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="BIBLIOTECA EXTERNA" FontSize="9" LetterSpacing="2" Foreground="#BDA37B" />
              <TextBlock Text="Tus historias" FontFamily="Georgia" FontSize="28" Foreground="#F0D9AF" />
            </StackPanel>
            <Button Grid.Column="1" Content="Cambiar carpeta" Click="ChooseWorkspace_Click" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <ScrollViewer Grid.Row="1">
          <Grid Margin="34" RowDefinitions="Auto,Auto,*">
            <Border IsVisible="{Binding NeedsWorkspace}" Background="#DFC790" BorderBrush="#8A663B" BorderThickness="1" Padding="32" HorizontalAlignment="Stretch" VerticalAlignment="Top">
              <StackPanel MaxWidth="620" Spacing="13">
                <TextBlock Text="Elige dónde guardar tus proyectos" FontFamily="Georgia" FontSize="27" Foreground="#2A1A10" />
                <TextBlock Text="La aplicación comienza vacía. Puedes usar Documentos, un disco externo o una carpeta sincronizada; ninguna novela quedará dentro del ejecutable." TextWrapping="Wrap" FontSize="15" LineHeight="23" Foreground="#5D4731" />
                <Button Content="Elegir carpeta externa" Click="ChooseWorkspace_Click" HorizontalAlignment="Left" Margin="0,8,0,0" />
              </StackPanel>
            </Border>

            <Grid IsVisible="{Binding HasWorkspace}" ColumnDefinitions="*,Auto" Margin="0,0,0,22">
              <StackPanel>
                <TextBlock Text="OBRAS EN ESTA CARPETA" FontSize="9" LetterSpacing="1.8" Foreground="#665038" />
                <TextBlock Text="Crea una obra vacía o abre un proyecto compatible." FontFamily="Georgia" FontSize="18" Foreground="#39271A" />
              </StackPanel>
              <Button Grid.Column="1" Content="Actualizar" Click="Refresh_Click" />
            </Grid>

            <Grid Grid.Row="1" IsVisible="{Binding HasWorkspace}" ColumnDefinitions="*,Auto" Margin="0,0,0,22">
              <TextBox x:Name="NewProjectTitle" Watermark="Nombre de la nueva obra" Margin="0,0,8,0" />
              <Button Grid.Column="1" Content="+ Nueva obra vacía" Click="NewProject_Click" />
            </Grid>

            <StackPanel Grid.Row="2" IsVisible="{Binding HasWorkspace}">
              <Border IsVisible="{Binding HasNoProjects}" Background="#D8BF8C" BorderBrush="#947143" BorderThickness="1" Padding="24" Margin="0,0,0,12">
                <TextBlock Text="La carpeta está vacía. El primer proyecto que crees aparecerá aquí." Foreground="#5C432C" FontSize="14" />
              </Border>
              <ItemsControl ItemsSource="{Binding Projects}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="project-card">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="5">
                          <TextBlock Text="{Binding Status}" FontSize="9" LetterSpacing="1.2" Foreground="#765334" />
                          <TextBlock Text="{Binding ArchiveTitle}" FontFamily="Georgia" FontSize="22" FontWeight="SemiBold" Foreground="#271910" />
                          <TextBlock Text="{Binding StoryTitle}" FontFamily="Georgia" FontSize="14" Foreground="#60472F" />
                          <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,9,0,0">
                            <TextBlock Text="{Binding Characters, StringFormat='Fichas: {0}'}" FontSize="10" Foreground="#6B5137" />
                            <TextBlock Text="{Binding Relationships, StringFormat='Enlaces: {0}'}" FontSize="10" Foreground="#6B5137" />
                            <TextBlock Text="{Binding WorldEntries, StringFormat='Mundo: {0}'}" FontSize="10" Foreground="#6B5137" />
                            <TextBlock Text="{Binding MagicSystems, StringFormat='Magia: {0}'}" FontSize="10" Foreground="#6B5137" />
                          </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Abrir →" Click="OpenProject_Click" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </Grid>
    </Grid>

    <Border Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,18" Background="#241A13" BorderBrush="#725536" BorderThickness="1" Padding="12,8" IsVisible="{Binding HasStatusMessage}">
      <TextBlock Text="{Binding StatusMessage}" Foreground="#D9C4A1" FontSize="10" MaxWidth="520" TextWrapping="Wrap" />
    </Border>
  </Grid>
</Window>
